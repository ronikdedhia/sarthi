# Sarthi — example environment file
#
# Nothing below is required. Every one of these has a safe default (see
# backend/sarthi_backend/settings.py) — a fresh clone runs with zero setup, no API keys,
# no external accounts. Copy this to backend/.env only if you want to override a default;
# backend/.env is gitignored, so real values you put there never get committed.
#
# There is currently NOTHING here that needs a real external credential — Sarthi runs
# entirely against its own self-hosted mock_bpp simulator (see README.md / FEASIBILITY_RESEARCH.md
# for why: real ONDC registry access needs a registered business entity + domain -- see
# PHASE4_REGISTRATION_GUIDE.md for exactly what that takes). If that ever changes, this file
# is where a real value would go.

# --- Django ---
# Auto-generated fresh each process start if unset. Set this if you want sessions/cookies to
# survive a server restart during a demo; not needed for anything to work correctly.
DJANGO_SECRET_KEY=

# django_pyturso (default, embedded local file) or django.db.backends.sqlite3 as a fallback
# if Turso ever regresses — see FEASIBILITY_RESEARCH.md #5.
DJANGO_DB_ENGINE=

# --- ONDC / Beckn signing (demo keypairs for the local BAP <-> mock_bpp loop only) ---
# Auto-generated as a fresh Ed25519 keypair each process start if unset — meaningless outside
# this local mock network either way (never registered with the real ONDC registry). Only
# set these if you want stable subscriber IDs/keys across restarts.
ONDC_BAP_SUBSCRIBER_ID=
ONDC_BAP_KEY_ID=
ONDC_BAP_PRIVATE_KEY=
ONDC_BAP_PUBLIC_KEY=

ONDC_BPP_SUBSCRIBER_ID=
ONDC_BPP_KEY_ID=
ONDC_BPP_PRIVATE_KEY=
ONDC_BPP_PUBLIC_KEY=

# Points at mock_bpp's own endpoints on this same server by default. Only changes once real
# ONDC registry access exists (see PHASE4_REGISTRATION_GUIDE.md) and this would point at the
# real gateway instead.
ONDC_GATEWAY_BASE_URL=

# --- Async Beckn protocol (BUILD_PLAN.md Phase 4 readiness) ---
# Where mock_bpp (or a real gateway, once registered) sends this app's own on_search/
# on_select/on_init/on_confirm/on_status callbacks. Defaults to localhost:8000 for local dev;
# must be a real, externally-reachable https:// URL for real ONDC registry use.
SARTHI_BASE_URL=

# How long mock_bpp deliberately waits before calling back (real, not zero, so the async
# round trip is genuinely exercised). Real gateway latency isn't configurable, obviously.
MOCK_BPP_CALLBACK_DELAY_SECONDS=

# How long client.py polls for a callback before giving up. Must comfortably exceed
# MOCK_BPP_CALLBACK_DELAY_SECONDS (or a real gateway's real latency).
ONDC_CALLBACK_TIMEOUT_SECONDS=

# --- mock_bpp live-tracking simulation (BUILD_PLAN.md Phase 3) ---
# How long (seconds) after confirmation a simulated order advances confirmed -> in_progress
# -> completed. Defaults (8/20) are tuned to be watchable in a live demo; shrink further for
# a faster demo, or lengthen for a more realistic-feeling wait.
MOCK_ORDER_IN_PROGRESS_AFTER_SECONDS=
MOCK_ORDER_COMPLETED_AFTER_SECONDS=

# --- CORS ---
# Defaults to the Next.js dev server's own default port. Only needed if your frontend runs
# somewhere else.
CORS_ALLOWED_ORIGINS=

# --- Frontend (frontend/.env.local, not backend/.env) ---
# Defaults to http://localhost:8000. Only needed if the Django backend isn't on that host/port.
NEXT_PUBLIC_API_BASE_URL=
